# Copy to .env on the Linux server. Never commit .env.
APP_ENV=production
APP_DRY_RUN=true
APP_TIMEZONE=Asia/Shanghai
SCHEDULER_ENABLED=false
DAILY_SYNC_CRON=0 8 * * *
# Re-fetch the latest 22 local report dates: 14-day attribution + its prior 7-day baseline.
# Use 15 if the account only uses SP (7-day attribution); lower values skip incomplete ad alerts.
AD_ATTRIBUTION_REFRESH_DAYS=22
STORE_TIMEZONES_FILE=/app/data/store-timezones.json

# Optional remote MCP Streamable HTTP server (read-only query tools).
# Generate with: openssl rand -hex 32
MCP_HOST=0.0.0.0
MCP_PORT=8001
MCP_PATH=/mcp
MCP_BEARER_TOKEN=
# Leave allowed hosts empty for local-only access through 127.0.0.1.
# For a public TLS reverse proxy, add the exact host and host:* entries.
MCP_ALLOWED_HOSTS=
# Browser-based clients need their exact HTTPS origin(s); server-to-server clients usually omit Origin.
MCP_ALLOWED_ORIGINS=
MCP_BIND_IP=127.0.0.1
MCP_BIND_PORT=8001

# MariaDB credentials. Use long, unique passwords; keep them out of Git.
DB_HOST=db
DB_PORT=3306
DB_NAME=jxalert
DB_USER=jxalert
DB_PASSWORD=REPLACE_WITH_LONG_RANDOM_DB_PASSWORD
DB_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_LONG_RANDOM_ROOT_PASSWORD
API_BIND_IP=127.0.0.1
API_PORT=8000

# Lingxing OpenAPI. App key normally equals AppID; leave blank to use APP_ID.
LINGXING_BASE_URL=https://openapi.lingxing.com
# Optional: official Lingxing MCP for customer performance and performance notices.
# Get both values from Lingxing ERP > AI Assistant > Manage MCP. Never commit the key.
LINGXING_MCP_URL=
LINGXING_MCP_KEY=
LINGXING_APP_ID=
LINGXING_APP_KEY=
LINGXING_APP_SECRET=
LINGXING_ACCESS_TOKEN=
LINGXING_REFRESH_TOKEN=
# Fill exact paths and request bodies from the current Lingxing token API docs.
# Do not guess token endpoints or payload fields.
LINGXING_TOKEN_PATH=
LINGXING_REFRESH_PATH=
LINGXING_TOKEN_REQUEST_JSON={}
LINGXING_REFRESH_REQUEST_JSON={}
# Exact dotted JSON paths from the API response, e.g. data.access_token only if docs confirm it.
LINGXING_TOKEN_RESPONSE_PATH=
LINGXING_REFRESH_RESPONSE_PATH=
LINGXING_EXPIRES_IN_RESPONSE_PATH=
LINGXING_TOKEN_METHOD=POST
LINGXING_REFRESH_METHOD=POST
LINGXING_TOKEN_STORE_PATH=/app/data/secrets/lingxing-token.json
LINGXING_TIMEOUT=30
# Performance API timestamps have no timezone offset. Set the timezone used by the source system.
# Leave blank until verified; freshness will remain NOT_CONFIGURED rather than being reported normal.
LINGXING_PERFORMANCE_ENABLED=false
LINGXING_PERFORMANCE_SOURCE_TIMEZONE=
LINGXING_PERFORMANCE_MAX_AGE_HOURS=8
LINGXING_PERFORMANCE_PAGE_SIZE=200
LINGXING_PERFORMANCE_MAX_PAGES=1000

# Feishu group custom bot: one webhook points to one group; add per-group variables
# (e.g. FEISHU_WEBHOOK_URL_STORE1 / FEISHU_SIGN_SECRET_STORE1) when routing multiple groups.
FEISHU_ENABLED=false
FEISHU_WEBHOOK_URL=
FEISHU_SIGN_SECRET=
FEISHU_KEYWORD=
# Optional comma-separated Open IDs of group members to mention on every alert.
FEISHU_DEFAULT_AT_OPEN_IDS=
FEISHU_ROUTING_FILE=/app/data/feishu-routing.json
FEISHU_TIMEOUT=20

# Alert thresholds
ALERT_ORDER_CHANGE_RATIO=0.15
ALERT_HIGH_SPEND_RATIO=1.30
ALERT_LOW_SPEND_RATIO=0.50
ALERT_BUDGET_RATIO=0.90
ALERT_MIN_SPEND=20
ALERT_MIN_CLICKS=10
ALERT_MIN_ORDERS_BASELINE=1
# Persistent anomalies are escalated once on the third daily evaluation by default.
ALERT_ESCALATE_AFTER_DAYS=2

REPORT_DIR=/app/data/reports
RAW_DIR=/app/data/raw
