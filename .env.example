# Copy to .env on the Linux server. Never commit .env.
APP_ENV=production
# Keep true until SparkX, DeepSeek, Feishu and the recipients are verified in the console.
APP_DRY_RUN=true
APP_TIMEZONE=Asia/Shanghai
SCHEDULER_ENABLED=false

# MariaDB credentials. Use long, unique passwords; keep them out of Git.
DB_HOST=db
DB_PORT=3306
DB_NAME=jxalert
DB_USER=jxalert
DB_PASSWORD=REPLACE_WITH_LONG_RANDOM_DB_PASSWORD
DB_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_LONG_RANDOM_ROOT_PASSWORD
API_BIND_IP=127.0.0.1
API_PORT=8000

# SparkX MCP (the only data source, read-only). Prefer the owner console
# (SparkX 连接), which stores the token in a private 0600 file that takes precedence.
SPARKX_AI_TOKEN=
SPARKX_TIMEOUT=30

# DeepSeek (report narrative and the Feishu question bot). Prefer the owner console.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Feishu enterprise application (the only delivery transport).
FEISHU_ENABLED=false
FEISHU_TRANSPORT=app
FEISHU_APP_CREDENTIALS_FILE=/app/data/secrets/feishu-app.json
FEISHU_ROUTING_FILE=/app/data/feishu-routing.json
# Alias of the report group in the routing file's "groups" section.
FEISHU_DAILY_REPORT_CHAT_ID=
FEISHU_TIMEOUT=20
FEISHU_BOT_ENABLED=false

# Owner console (https origin served by the reverse proxy) and its private files.
CONSOLE_PUBLIC_URL=https://console.example.com
CONSOLE_OWNER_CREDENTIALS_FILE=/app/data/secrets/mcp-owner.json
CONSOLE_SESSIONS_FILE=/app/data/secrets/console-sessions.sqlite3
CONSOLE_FORWARDED_ALLOW_IPS=127.0.0.1
